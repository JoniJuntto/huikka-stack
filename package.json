{
	"name": "huikka-stack",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@types/bun": "^1.3.4",
			"better-auth": "1.6.9",
			"evlog": "^2.14.1",
			"next-themes": "^0.4.6",
			"@types/react-dom": "^19.2.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @huikka-stack/db db:push",
		"db:studio": "turbo -F @huikka-stack/db db:studio",
		"db:generate": "turbo -F @huikka-stack/db db:generate",
		"db:migrate": "turbo -F @huikka-stack/db db:migrate",
		"db:start": "turbo -F @huikka-stack/db db:start",
		"db:watch": "turbo -F @huikka-stack/db db:watch",
		"db:stop": "turbo -F @huikka-stack/db db:stop",
		"db:down": "turbo -F @huikka-stack/db db:down",
		"check": "biome check --write .",
		"email": "email dev --dir src/emails"
	},
	"dependencies": {
		"@huikka-stack/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@huikka-stack/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.9"
}
